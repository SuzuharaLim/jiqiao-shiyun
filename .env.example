# 認證後端環境變數範本 —— 複製成 .env（勿把真值進版控；正式用 Cloud Run env / Secret Manager）
NODE_ENV=production
PORT=8080

# 正式網址：給 Email 驗證/重設密碼連結用（Cloud Run 部署後填入，如 https://jiqiao-xxxx.run.app）
APP_URL=https://your-service.run.app

# SQLite 資料目錄。Cloud Run 檔案系統為暫存 → 用 /tmp；重佈署/擴充會重置。
# 正式請改用受管資料庫（見下方 DATABASE_URL）。
DATA_DIR=/tmp/authdata

# —— 正式化才需要（本示範未使用）——
# 寄信服務（擇一）：真正寄出驗證/重設信
# SENDGRID_API_KEY=
# SES_REGION=

# 持久化資料庫（改用 Cloud SQL / Postgres 取代 SQLite）
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# 共享 Session 儲存（多實例/自動擴充時）
# REDIS_URL=redis://host:6379
