# 後端環境變數範本 —— 本機開發可複製成 .env 並 `export`（勿把真值進版控）。
# 正式（Cloud Run）：一般設定用 --set-env-vars，機密（密碼/金鑰）用 Secret Manager + --set-secrets。

NODE_ENV=production
PORT=8080

# 正式網址：給 Email 驗證/重設密碼連結用（Cloud Run 部署後填入，如 https://jiqiao-xxxx.run.app）
APP_URL=https://your-service.run.app

# —— 資料庫（正式：Cloud SQL PostgreSQL）——
# A) Cloud Run 連 Cloud SQL（unix socket）：設這三個 + 部署時 --add-cloudsql-instances
INSTANCE_CONNECTION_NAME=your-project:asia-east1:jiqiao-db
DB_USER=jiqiao_app
DB_NAME=jiqiao
# DB_PASS 走 Secret Manager（--set-secrets=DB_PASS=jiqiao-db-pass:latest），勿寫這裡
# B) 或用連線字串（本機接 Cloud SQL Proxy / 灌種子時）：
# DATABASE_URL=postgresql://jiqiao_app:PASS@127.0.0.1:5432/jiqiao
# 未設任何 DB 變數：本機自動退回 SQLite（server/data/auth.db）；正式環境(NODE_ENV=production)會直接報錯提醒。

# —— AI 時光顧問（接你的 GPT / OpenAI；金鑰只在後端，永不進前端）——
# OPENAI_API_KEY=sk-...            # 正式請放 Secret Manager，勿寫這裡
# OPENAI_MODEL=gpt-5.6-luna        # 預設值。想壓成本改 gpt-5.4-nano（便宜 5 倍）
#   價格（2026-07，每 1M tokens 輸入/輸出）：
#     gpt-5.4-nano $0.20/$1.25　gpt-5.4-mini $0.75/$4.50　gpt-5.6-luna $1.00/$6.00
#   覺得語感不夠好再往上換一階；最新價格見 https://developers.openai.com/api/docs/pricing
# OPENAI_BASE_URL=https://api.openai.com/v1   # 用 Azure OpenAI 或相容服務時覆寫

# —— 金流（見 docs/金流-付款串接.md）——
# PAY_PROVIDER=stripe              # demo|stripe|tappay|newebpay|ecpay|linepay
# STRIPE_SECRET_KEY=sk_...         # Secret Manager
# STRIPE_WEBHOOK_SECRET=whsec_...  # Secret Manager

# —— 寄信（設了才會真的寄出驗證信/重設密碼信/訂單信；見 docs/寄信-Email設定.md）——
# 擇一設定即可，正式請放 Secret Manager。Cloud Run 只封鎖 25 埠，465/587 可用故 SMTP 可行。
#
# A) Google Gmail（推薦：免費 500 封/日，設定最快）
#    需先開兩步驟驗證，再到 https://myaccount.google.com/apppasswords 產生 16 碼「應用程式密碼」
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop     # 不是 Google 帳號密碼！空白會自動去除
#
# B) 通用 SMTP（如 Google Workspace 中繼，可用自家網域寄件；埠 465 隱式 TLS、587 自動 STARTTLS）
# SMTP_HOST=smtp-relay.gmail.com
# SMTP_PORT=465
# SMTP_USER=noreply@chengqi.tw
# SMTP_PASS=
#
# C) 第三方 HTTP API（可用自家網域，但需在 DNS 加 SPF/DKIM 驗證）
# RESEND_API_KEY=re_...            # 免費 3000 封/月
# SENDGRID_API_KEY=SG....
# BREVO_API_KEY=xkeysib-...
# MAILGUN_API_KEY=...              # 另需 MAILGUN_DOMAIN（歐盟區加 MAILGUN_BASE=https://api.eu.mailgun.net）
# MAILGUN_DOMAIN=mg.chengqi.tw
#
# MAIL_FROM=機巧時運 <noreply@chengqi.tw>   # 用 Gmail 時位址會自動對齊成 GMAIL_USER（只保留顯示名）
# MAIL_REPLY_TO=hello@chengqi.tw            # 建議：使用者按「回覆」時的收件地址
# MAIL_PROVIDER=gmail                       # 選用：強制指定；不設則自動偵測
# ★ APP_URL 一定要設對，否則信中連結會指向 localhost
